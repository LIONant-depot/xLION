// xLION: the FAST smoke tests on Linux, for check-ins: the reliable, broad test files of Build/ci/fast_files.txt, in TWO LEGS that run at the same time on two agents:
//   Debug   (agent label "debug"):   the Debug build, then the tests; the asserts of the engine exist only here.
//   Release (agent label "release"): the Release build, then the same tests; the optimizer exposes what Debug hides.
// The check-in is green when both are. Each leg has its own results (results-Debug, results-Release) and its own known failures list (Build/ci/known_failures_linux[_release].txt).
//
// Create it in Jenkins as: New Item > Pipeline "xlion-fast" > Pipeline script from SCM > Git > https://github.com/LIONant-depot/xLION.git, branch */main,
// Script Path "Build/jenkins/Jenkinsfile.fast". It has no schedule of its own: the small job "xlion-poll" (Jenkinsfile.poll) starts it when any repo of the
// project has a new commit, and it can be started by hand (FORCE). The result is the same kind of report as the full job: documentation/Linux/jenkins.md.
// The agents and their labels: team38 "debug" (the Debug leg), team37 "release" (the Release leg), team39 "full san" (the poll, the full run, the sanitizer: once a day each, so the controller stays calm). A machine with both legs' labels would do them one after the other.

def runLeg(String cfg, boolean scratch) {
    def flags = scratch ? '--scratch ' : ''
    timeout(activity: true, time: 20, unit: 'MINUTES') {      // the scripts print a heartbeat every minute: 20 minutes of nothing means the script itself is stuck
        sh """#!/bin/bash
mkdir -p "\$WORKSPACE/results-${cfg}"
bash Build/ci/ci_run.sh --tier fast --config ${cfg} --tree "\${CI_TREE:-\$HOME/xlion-ci/tree}" --results "\$WORKSPACE/results-${cfg}" ${flags}
"""
    }
}

def collectLeg(String cfg) {
    def r = "results-${cfg}"
    junit testResults: "${r}/suite.xml", allowEmptyResults: true
    archiveArtifacts artifacts: "${r}/**", allowEmptyArchive: true
    def status = fileExists("${r}/status.txt") ? readFile("${r}/status.txt").trim() : 'FAILED'
    def desc   = fileExists("${r}/description.txt") ? readFile("${r}/description.txt").trim().replace('\n', ' | ') : 'no result: see the console log'
    env."LEG_${cfg}" = "${status}\t${desc}"                   // for the build name, which is made when both legs are done
    if (fileExists("${r}/summary.md")) { echo readFile("${r}/summary.md") }
}

pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 3, unit: 'HOURS')         // the first run on an empty tree builds everything
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '200', artifactNumToKeepStr: '60'))
    }

    parameters {
        booleanParam(name: 'FORCE', defaultValue: false, description: 'Run even when no repo has a new commit')
        booleanParam(name: 'SCRATCH', defaultValue: false, description: 'Delete the checkout and the build and start from nothing')
    }

    stages {
        stage('Debug and Release') {
            parallel {
                stage('Debug') {
                    agent { label 'debug' }          // team38; the agent runs as a low-privilege user (not the Jenkins server's own node): see documentation/Linux/jenkins.md
                    steps { script { runLeg('Debug', params.SCRATCH) } }
                    post { always { script { collectLeg('Debug') } } }
                }
                stage('Release') {
                    agent { label 'release' }
                    steps { script { runLeg('Release', params.SCRATCH) } }
                    post { always { script { collectLeg('Release') } } }
                }
            }
        }
    }

    post {
        always {
            script {
                def names = []; def descs = []; def bad = false
                ['Debug', 'Release'].each { cfg ->
                    def leg = (env."LEG_${cfg}" ?: "FAILED\tno result: see the console log").split('\t', 2)
                    names << "${cfg.substring(0, 1)}:${leg[0]}"
                    descs << "${cfg}: ${leg.size() > 1 ? leg[1] : ''}"
                    if (leg[0] == 'NEW' || leg[0] == 'FAILED' || leg[0] == 'NOTESTS') { bad = true }
                }
                currentBuild.displayName = "#${env.BUILD_NUMBER} ${names.join(' ')}"
                currentBuild.description = descs.join(' || ')
                if (bad) { currentBuild.result = 'FAILURE' }
            }
        }
    }
}
