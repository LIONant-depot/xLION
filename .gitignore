/.vs
# Only the generated project tree is ignored, not Build/ itself - CreateProject.bat (the
# double-click project-setup script, same convention as xGPU's own Build/CreateProject.bat) lives
# directly in Build/ and needs to be tracked.
/Build/xLION.vs2022
/Build/xLION.linux
/Build/CrashDumps
/Build/_transform_impl_scratch
/Build/_*.txt
/Build/_*.py
/dependencies
/plugins
/example.lionprj

# Scratch/log output from manual build investigation - never real deliverables
/_build_*.txt
/_configure_log.txt
/_isolated*.obj
/_preproc*.i
/_xlion_std*.log

/*.png
/*.tga
/*.pdb

# Local tool caches (Serena/graphify code-analysis indexing) - machine-local, not project state
/.serena
/graphify-out
